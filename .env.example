# CS2 Tactical HQ - Configuration Backend
PORT=8000
HOST=127.0.0.1

# Clés d'API Externes (Optionnelles - Mode Mock disponible)
# Obtenir sur: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Obtenir sur: https://developers.faceit.com/
FACEIT_API_KEY=

# Mode Mock / Données Démo :
# Si 'true', ou si les clés sont vides, des données simulées réalistes seront générées pour Steam, Faceit et Refrag.
USE_MOCK_DATA=true

# Durée de validité du cache en minutes pour les données externes (Steam, Faceit, Refrag)
EXTERNAL_CACHE_TTL_MINUTES=30

# Base de données SQLite locale
DATABASE_URL=sqlite:///./cs2_tactical_hq.db
